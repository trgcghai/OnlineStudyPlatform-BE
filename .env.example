# Copy to `.env` and fill in values. No fallbacks — the app fails to start if any variable below is missing or invalid.
PORT=

# PostgreSQL (TypeORM). For local dev, DB_HOST=localhost and ports match the docker-compose port mapping.
# Note: compose publishes postgres on host port 5433.
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Redis (ioredis). For local dev, REDIS_HOST=localhost and ports match the docker-compose port mapping.
REDIS_HOST=
REDIS_PORT=

# RabbitMQ. For local dev, use amqp://kltn:change-me-strong-password@localhost:5672.
RABBITMQ_URL=

# MongoDB (mongoose). For local dev, MONGODB_URI=mongodb://localhost:27017/kltn.
MONGODB_URI=

# MinIO (minio). For local dev, MINIO_ENDPOINT=http://localhost:9000.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=

# JWT authentication. Use long random secrets for local/dev/prod environments.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=

# SePay payment for paid courses. SEPAy_BANK_CODE is the SePay bank short code (e.g. VCB).
SEPAY_BANK_CODE=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_HOLDER=
# Optional; payment code prefix, defaults to KLTN. (default: KLTN)
SEPAY_PAYMENT_CODE_PREFIX=
# Webhook auth mode: hmac | apikey | none. (default: hmac)
SEPAY_WEBHOOK_AUTH_MODE=
SEPAY_WEBHOOK_AUTH_SECRET=
# Optional; accepted signature freshness window in seconds. (default: 300)
SEPAY_SIGNATURE_TTL_SECONDS=
# Optional; checkout expiry in minutes. (default: 30)
PAYMENT_EXPIRE_MINUTES=
AI_URL=
AI_TOKEN=
AI_TIMEOUT_MS=
AI_CHAT_SIMILARITY_THRESHOLD=
# Environment: development | production
NODE_ENV=development
